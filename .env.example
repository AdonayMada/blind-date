# Telegram Bot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blind_date_bot?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=blind_date_bot

# Comma-separated Telegram user IDs with admin privileges (optional)
ADMIN_IDS=

# Matchmaking constraints
MIN_AGE=18
MAX_AGE=99

# Environment: development | production
ENVIRONMENT=production
